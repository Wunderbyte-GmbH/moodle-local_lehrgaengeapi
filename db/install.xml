<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/lehrgaengeapi/db" VERSION="2026021700" COMMENT="XMLDB file for local_lehrgaengeapi"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">

  <TABLES>

    <TABLE NAME="local_lehrgaengeapi_coursemap" COMMENT="Maps external Lehrgang IDs to Moodle course IDs">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="externalid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="External Lehrgang.id"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Moodle course.id (nullable until linked)"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Creation timestamp"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Last modification timestamp"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="externalid_uix" UNIQUE="true" FIELDS="externalid"/>
        <INDEX NAME="courseid_ix" UNIQUE="false" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_lehrgaengeapi_usermap" COMMENT="Maps external participant initialId to Moodle user IDs">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="externalinitialid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="External Teilnehmer.initialId"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Moodle user.id (nullable until linked)"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Creation timestamp"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Last modification timestamp"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="externalinitialid_uix" UNIQUE="true" FIELDS="externalinitialid"/>
        <INDEX NAME="userid_ix" UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_lehrgaengeapi_import_run" COMMENT="Log of manual and automatic Lehrgaenge sync/import runs">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="year" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Filtered year, null = automatic/latest run without year filter"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" DEFAULT="running" COMMENT="running|success|error|skipped"/>
        <FIELD NAME="triggeredby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="user.id who triggered a manual run, null for automatic/cron"/>
        <FIELD NAME="timestarted" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0" COMMENT="Run start timestamp"/>
        <FIELD NAME="timeended" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Run end timestamp, null while running"/>
        <FIELD NAME="summary" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON-encoded per-tenant summary or error details"/>
        <FIELD NAME="runtype" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="import" SEQUENCE="false" COMMENT="import|link"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="timestarted_ix" UNIQUE="false" FIELDS="timestarted"/>
      </INDEXES>
    </TABLE>
        <TABLE NAME="local_lehrgaengeapi_usertenant" COMMENT="Tenants through which a user was delivered by the API">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle user.id"/>
        <FIELD NAME="tenantabbr" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="Tenant abbreviation, e.g. FD"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_tenantabbr_uix" UNIQUE="true" FIELDS="userid, tenantabbr"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_lehrgaengeapi_link_result" COMMENT="One row per linking run, user and Ausbildung with its outcome">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="runid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="local_lehrgaengeapi_import_run.id"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle user.id"/>
        <FIELD NAME="tenantabbr" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="Tenant the course was found in, null = user without remembered tenant"/>
        <FIELD NAME="bezeichnung" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="kurzbezeichnung" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="von" TYPE="char" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="YYYY-MM-DD"/>
        <FIELD NAME="bis" TYPE="char" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="YYYY-MM-DD"/>
        <FIELD NAME="apistatus" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="Status of the Ausbildung as delivered by the API"/>
        <FIELD NAME="outcome" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false" COMMENT="What the linking did with this Ausbildung"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Target course, null if none was found"/>
        <FIELD NAME="message" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Error details"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="runid_fk" TYPE="foreign" FIELDS="runid" REFTABLE="local_lehrgaengeapi_import_run" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="runid_outcome_ix" UNIQUE="false" FIELDS="runid, outcome"/>
        <INDEX NAME="userid_ix" UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>